{
  "mcpServers": {
    "dsh_project": {
      "command": "node",
      "args": ["./bin/bridge.mjs"],
      "tool_timeout_sec": 75,
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "DSH_MCP_TOKEN",
        "DSH_BRIDGE_CREDENTIAL_FILE",
        "DSH_BRIDGE_DELEGATED",
        "DSH_BRIDGE_DISABLED",
        "DSH_BRIDGE_URL",
        "DSH_BRIDGE_WATCHDOG_CONFIG",
        "AGENT_BRIDGE_CHAIN",
        "AGENT_BRIDGE_ROOT_TASK",
        "AGENT_BRIDGE_MAX_DEPTH",
        "AGENT_BRIDGE_MAX_DELEGATE_DEPTH"
      ]
    },
    "agent_peer": {
      "command": "node",
      "args": [
        "./bin/peer-mcp.mjs"
      ],
      "tool_timeout_sec": 75,
      "default_tools_approval_mode": "approve",
      "env": {
        "AGENT_BRIDGE_SELF": "codex",
        "AGENT_PEER_CONFIG": ""
      },
      "env_vars": [
        "DSH_MCP_TOKEN",
        "DSH_BRIDGE_CREDENTIAL_FILE",
        "DSH_BRIDGE_DELEGATED",
        "DSH_BRIDGE_DISABLED",
        "DSH_BRIDGE_URL",
        "AGENT_BRIDGE_CHAIN",
        "AGENT_BRIDGE_MAX_DEPTH",
        "AGENT_BRIDGE_MAX_DELEGATE_DEPTH",
        "AGENT_BRIDGE_ROOT_TASK"
      ]
    }
  }
}
