{
  "mcpServers": {
    "dsh_project": {
      "url": "http://127.0.0.1:3080/mcp/codex-bridge-v1",
      "bearer_token_env_var": "DSH_MCP_TOKEN",
      "tool_timeout_sec": 75,
      "default_tools_approval_mode": "approve"
    },
    "agent_peer": {
      "command": "node",
      "args": [
        "./bin/peer-mcp.mjs"
      ],
      "tool_timeout_sec": 75,
      "default_tools_approval_mode": "approve",
      "env": {
        "AGENT_BRIDGE_SELF": "codex",
        "AGENT_PEER_CONFIG": ""
      },
      "env_vars": [
        "AGENT_BRIDGE_CHAIN",
        "AGENT_BRIDGE_MAX_DEPTH",
        "AGENT_BRIDGE_MAX_DELEGATE_DEPTH",
        "AGENT_BRIDGE_ROOT_TASK"
      ]
    }
  }
}